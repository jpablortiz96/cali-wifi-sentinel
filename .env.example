# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Open-Meteo
# Open-Meteo no requiere API key para uso gratuito/no comercial.
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_CUSTOMER_BASE_URL=https://customer-api.open-meteo.com/v1/forecast
OPEN_METEO_CUSTOMER_ARCHIVE_URL=https://customer-archive-api.open-meteo.com/v1/archive
OPEN_METEO_USE_CUSTOMER_API=false

# OpenStreetMap / Overpass
# Overpass público normalmente no requiere API key.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_API_KEY=
OVERPASS_TIMEOUT_SECONDS=60
OVERPASS_RADIUS_M=700

# External APIs behavior
EXTERNAL_API_CACHE_TTL_HOURS=720
EXTERNAL_API_MAX_POINTS=25
ENABLE_OPEN_METEO=true
ENABLE_OVERPASS=true

APP_ENV=development